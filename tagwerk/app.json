{
  "expo": {
    "name": "Tagwerk",
    "slug": "tagwerk",
    "scheme": "tagwerk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#0B0E1A" },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.tagwerk.sleep",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Tagwerk liest deine Schlafdaten, um Schlafbedarf, Schlafschuld und deinen Rhythmus zu schätzen. Die Daten bleiben auf deinem Gerät.",
        "NSCalendarsUsageDescription": "Tagwerk zeigt deine Termine neben deinen Energiefenstern an."
      }
    },
    "android": {
      "package": "app.tagwerk.sleep",
      "permissions": ["android.permission.health.READ_SLEEP", "android.permission.READ_CALENDAR", "android.permission.WRITE_CALENDAR"],
      "adaptiveIcon": { "backgroundColor": "#0B0E1A", "foregroundImage": "./assets/android-icon-foreground.png" }
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router", "expo-sqlite", "expo-font", "expo-audio", "expo-sharing", "expo-background-task", "expo-notifications"],
    "experiments": { "typedRoutes": false }
  }
}
